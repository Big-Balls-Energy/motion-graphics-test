   ],
   "vis": "[LATA_AGUA] cae al centro con impacto, sacudida y polvo; detrás explotan rayos rojos y «$1,400,000,000» cuenta rápido. Sello «VALUACIÓN 2024»."
  },
  {
   "id": "origen",
   "name": "EL ORIGEN (2009)",
   "a": 4.25,
   "b": 12,
   "tr": "tear",
   "vis": "La cinta de tiempo marca 2009. Cartel fotocopiado de un concierto punk genérico con multitud en silueta; [AVATAR_MIKE_CESSARIO] «Mike Cessario · fundador». Un fan levanta una lata de energética genérica, se encierra en rojo («¿AGUA?») y la cámara hace zoom."
  },
  {
   "id": "idea",
   "name": "LA IDEA",
   "a": 12,
   "b": 18.6,
   "tr": "slam",
   "vis": "Botella de plástico gris y genérica; un sello rojo «ABURRIDA» la tacha. Entra [LATA_SPARKLING] girando en 2.5D, anillos gráficos la envuelven (mitad detrás, mitad delante), gotas y rayos."
  },
  {
   "id": "video",
   "name": "EL VIDEO ANTES DEL PRODUCTO",
   "a": 18.6,
   "b": 30.1,
   "tr": "tear",
   "vis": "Celular genérico con un video y contador de vistas; silueta punteada «SIN PRODUCTO». «$1,500» y «≈3 MILLONES DE VISTAS» solos en pantalla. La cinta avanza a 2019; billetes salen del celular y construyen [LATA_AGUA] por capas."
  },
  {
   "id": "disrup",
   "name": "LA DISRUPCIÓN",
   "a": 30.1,
   "b": 38.1,
   "tr": "slam",
   "vis": "[LATA_SABOR] cae al centro. Recortes: calavera genérica, «FORMATO CERVEZA», «MATA TU SED» en letras de nota de rescate; un vinilo sale de detrás de la lata, los comentarios de odio se convierten en notas musicales."
  },
  {
   "id": "gente",
   "name": "LA GENTE DETRÁS",
   "a": 38.1,
   "b": 45.1,
   "tr": "tear",
   "vis": "[AVATAR_GARY_VEE] «Gary Vee · inversionista» lanza una moneda dentro de [LATA_AGUA]; la cinta avanza a 2024 y 2026; [AVATAR_MRBEAST] «MrBeast · colaboración Feastables» y entre ambos [LATA_COLAB_FEASTABLES] con brillo."
  },
  {
   "id": "leccion",
   "name": "LA LECCIÓN",
   "a": 45.1,
   "b": 51.45,
   "tr": "slide",
   "vis": "Sello «LA LECCIÓN». Fila de latas grises idénticas; [LATA_AGUA] da un paso al frente y recupera el color; «IDENTIDAD» enorme en rojo pasa por detrás de ella."
  },
  {
   "id": "cta",
   "name": "CTA CON PALABRA CLAVE",
   "a": 51.45,
   "b": 60,
   "tr": "tear",
   "vis": "Burbuja de comentario que escribe «DISRUPTIVO» → la palabra sola y grande 3 s → logo, «ATLAS PATH», @Atlas_Path y botón SEGUIR con clic. Texto pequeño «Caso de estudio. Sin afiliación con la marca.» → regresa a la lata cayendo (loop)."
  }
 ],
 "subs": [
  {
   "a": 0,
   "b": 1.75,
   "text": "Esta marca vende agua…",
   "keys": [
    "agua"
   ]
  },
  {
   "a": 4.25,
   "b": 6.136,
   "text": "En 2009, su fundador",
   "keys": [
    "fundador"
   ]
  },
  {
   "a": 6.136,
   "b": 8.022,
   "text": "vio en un concierto",
   "keys": [
    "concierto"
   ]
  },
  {
   "a": 8.022,
   "b": 9.614,
   "text": "gente tomando agua",
   "keys": [
    "agua"
   ]
  },
  {
   "a": 9.614,
   "b": 11.5,
   "text": "en latas de energética.",
   "keys": [
    "energética"
   ]
  },
  {
   "a": 12,
   "b": 13.972,
   "text": "Y pensó: ¿y si",
   "keys": [
    "pensó"
   ]
  },
  {
   "a": 13.972,
   "b": 16.436,
   "text": "el agua fuera tan rebelde",
   "keys": [
    "rebelde"
   ]
  },
  {
   "a": 16.436,
   "b": 18.1,
   "text": "como una energética?",
   "keys": [
    "energética"
   ]
  },
  {
   "a": 18.6,
   "b": 20.35,
   "text": "Antes de tener producto,",
   "keys": [
    "producto"
   ]
  },
  {
   "a": 20.35,
   "b": 22.1,
   "text": "gastó en un video:",
   "keys": [
    "video"
   ]
  },
  {
   "a": 26.1,
   "b": 27.85,
   "text": "y levantó 1.6 millones",
   "keys": [
    "millones"
   ]
  },
  {
   "a": 27.85,
   "b": 29.6,
   "text": "para fabricar sus latas.",
   "keys": [
    "latas"
   ]
  },
  {
   "a": 30.1,
   "b": 31.975,
   "text": "Calaveras, lata de cerveza",
   "keys": [
    "calaveras"
   ]
  },
  {
   "a": 31.975,
   "b": 33.85,
   "text": "lema: «Mata tu sed».",
   "keys": [
    "mata",
    "sed"
   ]
  },
  {
   "a": 33.85,
   "b": 35.725,
   "text": "Hasta grabaron un disco",
   "keys": [
    "disco"
   ]
  },
  {
   "a": 35.725,
   "b": 37.6,
   "text": "con comentarios de odio.",
   "keys": [
    "odio"
   ]
  },
  {
   "a": 38.1,
   "b": 40.1,
   "text": "Gary Vee también invirtió.",
   "keys": [
    "invirtió"
   ]
  },
  {
   "a": 40.1,
   "b": 42.1,
   "text": "Y este año, MrBeast",
   "keys": [
    "mrbeast"
   ]
  },
  {
   "a": 42.1,
   "b": 44.6,
   "text": "lanzó un sabor con ellos.",
   "keys": [
    "sabor"
   ]
  },
  {
   "a": 45.1,
   "b": 47.157,
   "text": "Si tu categoría aburre,",
   "keys": [
    "aburre"
   ]
  },
  {
   "a": 47.157,
   "b": 49.214,
   "text": "no compitas en producto.",
   "keys": [
    "producto"
   ]
  },
  {
   "a": 49.214,
   "b": 50.95,
   "text": "Compite en identidad.",
   "keys": [
    "identidad"
   ]
  },
  {
   "a": 51.45,
   "b": 52.95,
   "text": "Comenta la palabra…",
