  },
  {
   "a": 13.003,
   "b": 14.263,
   "text": "citas y todo mientras"
  },
  {
   "a": 14.243,
   "b": 15.043,
   "text": "intentas cumplir"
  },
  {
   "a": 15.023,
   "b": 15.923,
   "text": "con las demás tareas"
  },
  {
   "a": 15.903,
   "b": 16.603,
