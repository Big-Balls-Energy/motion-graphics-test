  },
  {
   "id": "p1",
   "name": "1 · AGRADECE Y USA SU NOMBRE",
   "a": 16.3,
   "b": 21.6,
   "vis": "Celular: debajo de la reseña se escribe «Gracias, Laura, por avisarnos.»."
  },
  {
   "id": "p2",
   "name": "2 · RECONOCE, SIN PELEAR",
   "a": 21.6,
   "b": 26.7,
   "vis": "Celular: se agrega «Tienes razón: esperar 40 minutos no está bien.»."
  },
  {
   "id": "p3",
   "name": "3 · DI QUÉ VAS A CAMBIAR",
   "a": 26.7,
   "b": 31.5,
   "vis": "Celular: se agrega «Desde esta semana hay una persona más en la barra en horas pico.»."
  },
  {
   "id": "p4",
   "name": "4 · LLÉVALO A PRIVADO",
   "a": 31.5,
   "b": 36.7,
   "vis": "Celular: se agrega «Escríbenos por WhatsApp y tu próximo café va por nuestra cuenta.»."
  },
  {
   "id": "copiadas",
   "name": "EVITA LAS RESPUESTAS COPIADAS: 50%",
   "a": 36.7,
   "b": 41.9,
   "vis": "Fondo oscuro. Tarjeta con una respuesta de plantilla y sello «COPIADA»; «50%»."
  },
  {
   "id": "cta",
   "name": "CIERRE Y CTA CON PALABRA CLAVE",
   "a": 41.9,
   "b": 53,
   "vis": "W01_mano_celular.png: en los comentarios se escribe «RESEÑA», que sale grande y se queda 3 s sola con anillos. Sobre W09_equipo_estrategia.jpg: logo, «ATLAS PATH», @Atlas_Path y botón SEGUIR con clic; el último medio segundo regresa al primer cuadro (loop)."
  }
 ],
