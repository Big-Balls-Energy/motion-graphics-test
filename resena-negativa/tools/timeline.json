  {
   "id": "hook",
   "name": "HOOK: UNA RESEÑA DE UNA ESTRELLA",
   "a": 0,
   "b": 5.3,
   "vis": "Fondo oscuro rojizo. Celular (W01_mano_celular.png) con un perfil de reseñas genérico; entra la reseña de 1 estrella de «Laura M.». «UNA ESTRELLA… ¿Y AHORA QUÉ CONTESTO?»."
  },
  {
   "id": "dato",
   "name": "EL 80% PREFIERE NEGOCIOS QUE RESPONDEN",
   "a": 5.3,
   "b": 12.4,
   "vis": "W06_cliente_resena.jpg. Chip «ENCUESTA BRIGHTLOCAL 2026», «80%» y «prefiere un negocio que responde TODAS sus reseñas»."
  },
  {
   "id": "responde",
   "name": "RESPONDE EN 4 PASOS",
   "a": 12.4,
   "b": 16.3,
