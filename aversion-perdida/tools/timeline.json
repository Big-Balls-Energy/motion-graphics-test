 "subs": [
  {
   "a": 0,
   "b": 2.5,
   "text": "¿Por qué «no pierdas» funciona?",
   "keys": [
    "pierdas"
   ]
  },
  {
   "a": 3,
   "b": 4.75,
   "text": "Misma oferta, distinto efecto.",
   "keys": [
    "efecto"
   ]
  },
  {
   "a": 4.75,
   "b": 7.5,
   "text": "Es aversión a la pérdida.",
   "keys": [
    "aversión",
    "pérdida"
   ]
  },
  {
   "a": 8,
   "b": 10,
   "text": "Juego: lanzamos una moneda.",
   "keys": [
    "moneda"
   ]
  },
  {
   "a": 10,
   "b": 11.8,
   "text": "Si sale águila, ganas…",
   "keys": [
    "ganas"
   ]
  },
  {
   "a": 13.8,
   "b": 15.6,
   "text": "Si sale sol, pierdes…",
   "keys": [
    "pierdes"
   ]
  },
  {
   "a": 17.6,
   "b": 19.5,
   "text": "¿Tú le entras?",
   "keys": [
    "entras"
   ]
  },
  {
   "a": 20,
   "b": 22.2,
   "text": "La mayoría dice que no.",
   "keys": [
    "no"
   ]
  },
  {
   "a": 22.2,
   "b": 24,
   "text": "Según Kahneman y Tversky,",
   "keys": [
    "kahneman",
    "tversky"
   ]
  },
  {
   "a": 24,
   "b": 25.5,
   "text": "por arriesgar $100",
   "keys": [
    "$100"
   ]
  },
  {
   "a": 25.5,
   "b": 27.3,
   "text": "piden ganar casi $200",
   "keys": [
    "$200"
   ]
  },
  {
   "a": 30,
   "b": 33.026,
   "text": "Perder duele cerca del doble",
   "keys": [
    "doble"
   ]
  },
  {
   "a": 33.026,
   "b": 36.053,
   "text": "de lo que disfrutas ganar.",
   "keys": [
    "ganar"
   ]
  },
  {
   "a": 36.053,
   "b": 39.079,
   "text": "Por eso tu cerebro protege",
   "keys": [
    "protege"
   ]
  },
  {
   "a": 39.079,
   "b": 41.5,
   "text": "lo que siente suyo.",
   "keys": [
    "suyo"
   ]
  },
  {
   "a": 42,
   "b": 44.5,
   "text": "En «no pierdas tu descuento»",
   "keys": [
    "pierdas"
   ]
  },
  {
   "a": 44.5,
   "b": 46.5,
   "text": "en «tu carrito expira»",
   "keys": [
    "expira"
   ]
  },
  {
   "a": 46.5,
   "b": 48,
   "text": "en pruebas gratis",
   "keys": [
    "gratis"
   ]
  },
  {
   "a": 48,
   "b": 49.5,
   "text": "que cuesta cancelar:",
   "keys": [
    "cancelar"
   ]
  },
  {
   "a": 49.5,
   "b": 51.5,
   "text": "ya las sientes tuyas.",
   "keys": [
    "tuyas"
   ]
  },
  {
   "a": 52,
   "b": 54,
   "text": "No digas qué gana,",
   "keys": [
    "gana"
   ]
  },
  {
   "a": 54,
   "b": 56.5,
   "text": "dile qué podría perder.",
   "keys": [
    "perder"
   ]
  },
  {
   "a": 57,
   "b": 59.5,
   "text": "Síguenos para no perderte nada",
