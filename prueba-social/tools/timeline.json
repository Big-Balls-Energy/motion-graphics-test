 "subs": [
  {
   "a": 0,
   "b": 2.5,
   "text": "¿Por qué eliges el lleno?",
   "keys": [
    "lleno"
   ]
  },
  {
   "a": 3,
   "b": 4.75,
   "text": "No es la comida.",
   "keys": [
    "comida"
   ]
  },
  {
   "a": 4.75,
   "b": 7.5,
   "text": "Es psicología: prueba social.",
   "keys": [
    "prueba",
    "social"
   ]
  },
  {
   "a": 8,
   "b": 10.5,
   "text": "Un hotel probó dos letreros",
   "keys": [
    "letreros"
   ]
  },
  {
   "a": 10.5,
   "b": 12.5,
   "text": "para reutilizar las toallas.",
   "keys": [
    "toallas"
   ]
  },
  {
   "a": 12.5,
   "b": 15,
   "text": "Uno: «Ayuda al medio ambiente»",
   "keys": [
    "medio",
    "ambiente"
   ]
  },
  {
   "a": 15,
   "b": 16.5,
   "text": "Otro: «La mayoría",
   "keys": [
    "mayoría"
   ]
  },
  {
   "a": 16.5,
   "b": 18,
   "text": "de los huéspedes",
   "keys": [
    "huéspedes"
   ]
  },
  {
   "a": 18,
   "b": 19.5,
   "text": "reutiliza su toalla»",
   "keys": [
    "reutiliza"
   ]
  },
  {
   "a": 20,
   "b": 21.8,
   "text": "Con el mensaje ecológico:",
   "keys": [
    "ecológico"
   ]
  },
  {
   "a": 23.8,
   "b": 25.3,
   "text": "Con «la mayoría»:",
   "keys": [
    "mayoría"
   ]
  },
  {
   "a": 27.3,
   "b": 29.5,
   "text": "Solo por imitar a otros.",
   "keys": [
    "imitar"
   ]
  },
  {
   "a": 30,
   "b": 32.421,
   "text": "Cuando no estás seguro,",
   "keys": [
    "seguro"
   ]
  },
  {
   "a": 32.421,
   "b": 34.237,
   "text": "tu cerebro copia",
   "keys": [
    "copia"
   ]
  },
  {
   "a": 34.237,
   "b": 36.053,
   "text": "a la mayoría.",
   "keys": [
    "mayoría"
   ]
  },
  {
   "a": 36.053,
   "b": 38.474,
   "text": "Si muchos lo eligen,",
   "keys": [
    "muchos"
   ]
  },
  {
   "a": 38.474,
   "b": 41.5,
   "text": "asumes que debe ser bueno.",
   "keys": [
    "bueno"
   ]
  },
  {
   "a": 42,
   "b": 43.8,
   "text": "Está en «más de…»",
   "keys": [
    "más",
    "de"
   ]
  },
  {
   "a": 45.8,
   "b": 47.6,
   "text": "en «lo más vendido»",
   "keys": [
    "más",
    "vendido"
   ]
  },
  {
   "a": 47.6,
   "b": 49.6,
   "text": "y en las estrellas",
   "keys": [
    "estrellas"
   ]
  },
  {
   "a": 49.6,
   "b": 51.5,
   "text": "de las reseñas.",
   "keys": [
    "reseñas"
   ]
  },
  {
   "a": 52,
   "b": 54.2,
   "text": "No digas que eres bueno.",
   "keys": [
    "bueno"
   ]
  },
  {
   "a": 54.2,
   "b": 56.5,
   "text": "Muestra quién te eligió.",
   "keys": [
    "eligió"
   ]
  },
  {
   "a": 57,
   "b": 59.5,
   "text": "Síguenos para más trucos",
   "keys": [
    "síguenos"
   ]
  }
 ],
