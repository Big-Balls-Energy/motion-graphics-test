 "scenes": [
  {
   "id": "hook",
   "name": "HOOK",
   "a": 0,
   "b": 6,
   "tr": null,
   "vis": "[LATA_PUNK_IPA] cae al centro con impacto; detrás «≈£2,000,000,000» en azul con conteo rápido, que de golpe se desploma a «£33,000,000» en rojo con una grieta sobre la lata."
  },
  {
   "id": "origen",
   "name": "EL ORIGEN (2007)",
   "a": 6,
   "b": 13.1,
   "tr": "tear",
   "vis": "Cinta en 2007; [AVATAR_JAMES_WATT] y [AVATAR_MARTIN_DICKIE] con etiquetas de cofundador. Fila de latas grises e iguales; una se tacha con el sello «ABURRIDO» y entra [LATA_PUNK_IPA] a color."
  },
  {
   "id": "stunts",
   "name": "LOS STUNTS",
   "a": 13.1,
   "b": 22.8,
   "tr": "slam",
   "vis": "Tres recortes de collage, uno por uno: botella con silueta de ardilla y «55%»; un tanque cruzando una calle genérica; un helicóptero del que caen gatitos con paracaídas (caricatura). Sellos «TITULAR» y «VIRAL». La línea de valor empieza a subir; la cinta pasa por 2010 y 2015."
  },
  {
   "id": "jugada",
   "name": "LA JUGADA MAESTRA (2009)",
   "a": 22.8,
   "b": 32.5,
   "tr": "tear",
   "vis": "Cinta en 2009; [LATA_HAZY_JANE] al centro; se multiplican íconos de personas con un certificado de acción; «≈200,000» y «≈£75 M» solos en pantalla; los certificados entran a la lata. La línea de valor sube con fuerza."
  },
  {
   "id": "caida",
   "name": "LA CAÍDA (2026)",
   "a": 32.5,
   "b": 44.7,
   "tr": "slam",
   "vis": "Cinta en 2017 con la etiqueta «Valuación +£1,000 M»; luego salta a 2026, la paleta cambia a rojo y la línea se desploma. [LATA_ELVIS_JUICE] y [PINTA_BLACK_HEART] pierden color y se agrietan. 38 bares se apagan uno por uno; los certificados de los fans se vuelven ceniza."
  },
  {
   "id": "leccion",
   "name": "LA LECCIÓN",
   "a": 44.7,
   "b": 51.4,
   "tr": "tear",
   "vis": "Pantalla dividida: megáfono con «ATENCIÓN» (azul) y cimientos de ladrillo con «NEGOCIO SÓLIDO». Se unen y [LATA_PUNK_IPA] recupera el color encima de los cimientos."
  },
  {
   "id": "cta",
   "name": "CTA CON PALABRA CLAVE",
   "a": 51.4,
   "b": 60,
   "tr": "tear",
   "vis": "Burbuja que escribe «PUNK» → «PUNK» sola y grande 3 s → logo, «ATLAS PATH», @Atlas_Path y botón SEGUIR con clic. Texto pequeño de aviso → regresa a la lata cayendo (loop)."
  }
 ],
