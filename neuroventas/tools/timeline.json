 "scenes": [
  {
   "id": "hook",
   "name": "HOOK",
   "a": 0,
   "b": 6,
   "vis": "K02_cliente_decidiendo.jpg desenfocado; dentro del marco del escáner se ve nítido. HUD con «ESCANEANDO CLIENTE…» y lecturas (la RAZÓN cae a casi cero); un BOTÓN_3D verde aparece frente a su cabeza y se presiona con onda expansiva; cuatro MOLECULAS_3D salen girando hacia la cámara."
  },
  {
   "id": "quien",
   "name": "QUIÉN LO EXPLICA",
   "a": 6,
   "b": 11,
   "vis": "K00_jurgen_klaric.png entra con rim light magenta; tres botones orbitan a su alrededor como un anillo (pasan por detrás de su cabeza y por delante de su pecho); K01_libro.png flota a su lado con el título escrito encima en la tipografía del video."
  },
  {
   "id": "cerebro",
   "name": "EL CEREBRO QUE DECIDE",
   "a": 11,
   "b": 19.95,
   "vis": "CEREBRO_3D de cristal con circunvoluciones de neón y red neuronal; «85%» en ámbar con «según Klaric · estimación del autor»; zoom hacia dentro del cerebro: la cámara viaja sobre rieles de luz por el CAMINO_NEURONAL como montaña rusa hasta el núcleo reptil verde; K03_lagarto.png aparece junto al núcleo y se funde en él."
  },
  {
   "id": "botones",
   "name": "LOS 11 BOTONES",
   "a": 19.95,
   "b": 32,
   "vis": "Los 11 BOTONES_3D salen del núcleo y orbitan alrededor del cerebro; cada uno se presiona, se ilumina y muestra su nombre cuando la voz lo dice (casa, escudo, corazón, estrella, manos unidas, ave, corona, engrane, brújula, trofeo, infinito); contador HUD 00/11; al final el anillo gira una vez."
  },
  {
   "id": "triada",
   "name": "TU TRIADA REPTIL",
   "a": 32,
   "b": 38.9,
   "vis": "Los botones se apagan y se alejan; PODER viene al frente (PRINCIPAL), CONTROL y SEGURIDAD a los lados (SECUNDARIOS); la TRIADA_3D los une con un triángulo de luz que se dibuja."
  },
  {
   "id": "ejemplos",
   "name": "EJEMPLOS",
   "a": 38.9,
   "b": 45.78,
   "vis": "Dos mini-escenas con parallax: K04_familia_auto.jpg con los botones SEGURIDAD y FAMILIA presionándose; K05_reloj_lujo.png girando con PODER y RECONOCIMIENTO."
  },
  {
   "id": "transicion",
   "name": "TRANSICIÓN A LA QUÍMICA",
   "a": 45.78,
   "b": 50.04,
   "vis": "Zoom hacia dentro del CEREBRO_3D hasta la SINAPSIS_3D; el indicador cambia a «PARTE 2 · QUÍMICA» con un glitch; aparece el ECUALIZADOR_3D pequeño con las cuatro barras en cero."
  },
  {
   "id": "dopamina",
   "name": "DOPAMINA",
   "a": 50.04,
   "b": 54.97,
   "vis": "La cámara sigue a la molécula amarilla cruzando la sinapsis; los receptores se encienden; destello y K06_unboxing.jpg con confeti amarillo; sube la barra amarilla."
  },
  {
   "id": "endorfinas",
   "name": "ENDORFINAS",
   "a": 54.97,
   "b": 61.55,
   "vis": "La molécula verde cruza la sinapsis; un nudo rojo de «dolor» se desata y se disuelve; K07_cliente_aliviado.jpg; etiqueta «FIDELIZA» en verde; sube la barra verde."
  },
  {
   "id": "serotonina",
   "name": "SEROTONINA",
   "a": 61.55,
   "b": 67.35,
   "vis": "La molécula azul cruza la sinapsis y se expande en ondas suaves; K08_amigos_felices.jpg con burbujas de emojis genéricos; sube la barra azul."
  },
  {
   "id": "acetilcolina",
   "name": "ACETILCOLINA",
   "a": 67.35,
   "b": 73.82,
   "vis": "La molécula violeta cruza la sinapsis y graba un ícono de marca genérico (estrella) en la neurona receptora, que queda brillando; K09_persona_aprendiendo.jpg; sube la barra violeta."
  },
  {
   "id": "leccion",
   "name": "LA LECCIÓN",
   "a": 73.82,
   "b": 79.6,
   "vis": "K11_cliente_sonriendo.jpg; la TRIADA_3D reaparece con las cuatro moléculas orbitando; el ECUALIZADOR_3D sube completo en armonía; K10_cartera_abriendo.png se abre con un destello."
  },
  {
   "id": "cta",
   "name": "CTA CON PALABRA CLAVE",
   "a": 79.6,
   "b": 90,
   "vis": "K00_jurgen_klaric.png regresa; una burbuja de comentario escribe «MENTE» en magenta y estalla en un BOTÓN_3D gigante con las cuatro moléculas (3 s sola); logo, «ATLAS PATH», @Atlas_Path y botón SEGUIR con clic; leyenda; regresa al escaneo del cliente (loop)."
  }
 ],
