 "scenes": [
  {
   "id": "hook",
   "name": "HOOK: EL CUADERNO QUE SE DESHACE",
   "a": 0,
   "b": 6.5,
   "vis": "Fondo azul marino. CUADERNO_3D: una hoja con apuntes de examen flota y gira despacio. «¿CUÁNTO DE LO QUE ESTUDIAS HOY… SEGUIRÁ AHÍ MAÑANA?». La hoja se desintegra de derecha a izquierda en miles de partículas que se lleva el viento."
  },
  {
   "id": "ebb",
   "name": "1885 · EBBINGHAUS",
   "a": 6.5,
   "b": 20.3,
   "vis": "«1885» enorme en contorno ámbar. Ficha de papel con «LISTA 1 · SÍLABAS SIN SENTIDO» que se escribe a máquina (WID, ZOF, KEB…) y un cronómetro. Chip «HERMANN EBBINGHAUS · PSICÓLOGO ALEMÁN» (solo texto). Las sílabas se borran al azar y aparece «EL OLVIDO» con letras que se desvanecen."
  },
  {
   "id": "curva",
   "name": "LA CURVA DEL OLVIDO",
   "a": 20.3,
   "b": 36.5,
   "vis": "CURVA_3D: un trazo de luz cae sobre una retícula con cortina luminosa; la cámara sigue la punta y marca 20 MIN (58%), 1 DÍA (34%) y 31 DÍAS (21%). La cámara se aleja y muestra la curva completa: «LA CURVA DEL OLVIDO» (3 s sola)."
  },
  {
   "id": "giro",
   "name": "RECUERDOS QUE LA DESAFÍAN",
   "a": 36.5,
   "b": 42,
   "vis": "La curva se atenúa y tres polaroids reales (Y03, Y16, Y05) suben brillando por encima del trazo, que se quiebra donde lo cruzan."
  },
  {
   "id": "emocion",
   "name": "LLAVE 1 · EMOCIÓN",
   "a": 42,
   "b": 50,
   "vis": "«1» en contorno y título EMOCIÓN. Y02_lancha_ria_cacerolita_de_mar.jpg en tarjeta que late como un corazón, con una línea de pulso que la recorre."
  },
  {
   "id": "accion",
   "name": "LLAVE 2 · ACCIÓN",
   "a": 50,
   "b": 58.5,
   "vis": "«2» y ACCIÓN. TARJETAS_3D con fotos de la obra social (S21, S19) y de la tirolesa (Y14) en abanico. «LEÍDO» se deshace en gris; «HECHO» queda firme en turquesa."
  },
  {
   "id": "repaso",
   "name": "LLAVE 3 · VOLVER A RECORDAR",
   "a": 58.5,
   "b": 72,
   "vis": "«3» y VOLVER A RECORDAR. BARRAS_CRISTAL_3D con reflejo: SE PUSIERON A PRUEBA sube a 61%, SOLO RELEYERON se queda en 40% (recuerdo una semana después)."
  },
  {
   "id": "sintesis",
   "name": "UN VIAJE QUE SE QUEDA",
   "a": 72,
   "b": 83.9,
   "vis": "Tres orbes de luz (EMOCIÓN, ACCIÓN, REPASO) giran y se funden en uno. La curva vuelve: la de siempre cae en gris y un trazo ilustrativo se mantiene alto en turquesa. Sobre Y05 desenfocada: «NO ES UN PASEO. ES UNA CLASE QUE SE QUEDA.» (3 s sola)."
  },
  {
   "id": "cta",
   "name": "CIERRE",
   "a": 83.9,
   "b": 90,
   "vis": "Miles de partículas forman el imagotipo de Vanguardia Academics; aparecen el avatar, «VANGUARDIA ACADEMICS», «VIAJES EDUCATIVOS A LA MEDIDA», @vanguardia.academics y el botón SEGUIR con clic. El último medio segundo regresa al cuaderno del inicio (loop)."
  }
 ],
 "subs": [
  {
   "a": 0.15,
   "b": 2.4,
   "text": "¿Cuánto de lo que estudias",
   "keys": [
    "estudias"
   ]
  },
  {
   "a": 2.4,
   "b": 3.95,
   "text": "seguirá ahí mañana?",
   "keys": [
    "mañana"
   ]
  },
  {
   "a": 6.7,
   "b": 9,
   "text": "En 1885, un psicólogo",
   "keys": [
    "psicólogo"
   ]
  },
  {
   "a": 9,
   "b": 11.2,
   "text": "alemán Hermann Ebbinghaus memorizó",
   "keys": [
    "ebbinghaus"
   ]
  },
  {
   "a": 11.2,
   "b": 14.9,
   "text": "listas de sílabas sin sentido…",
   "keys": [
    "sílabas"
   ]
  },
  {
   "a": 15.15,
   "b": 17.95,
   "text": "…para medir algo nunca medido:",
   "keys": [
    "medir"
   ]
  },
  {
   "a": 20.5,
   "b": 22.4,
   "text": "Veinte minutos después,",
   "keys": [
    "minutos"
   ]
  },
  {
   "a": 22.4,
   "b": 24.75,
   "text": "ya olvidó casi la mitad.",
   "keys": [
    "mitad"
   ]
  },
  {
   "a": 25.35,
   "b": 27,
   "text": "Al día siguiente,",
   "keys": [
    "siguiente"
   ]
  },
  {
   "a": 27,
   "b": 28.95,
   "text": "conservaba apenas un tercio.",
   "keys": [
    "tercio"
   ]
  },
  {
   "a": 29.55,
   "b": 32.4,
   "text": "Al mes, una quinta parte.",
   "keys": [
    "quinta"
   ]
  },
  {
   "a": 36.75,
   "b": 38.3,
   "text": "Pero hay recuerdos",
   "keys": [
    "recuerdos"
   ]
  },
  {
   "a": 38.3,
   "b": 39.95,
   "text": "que la desafían.",
   "keys": [
    "desafían"
   ]
  },
  {
   "a": 42.2,
   "b": 43.95,
   "text": "Los que llevan emoción:",
   "keys": [
    "emoción"
   ]
  },
  {
   "a": 43.95,
   "b": 47.35,
   "text": "lo que sorprende, se graba.",
   "keys": [
    "graba"
   ]
  },
  {
   "a": 50.2,
   "b": 51.95,
   "text": "Los que llevan acción:",
   "keys": [
    "acción"
   ]
  },
  {
   "a": 51.95,
   "b": 54.2,
   "text": "lo hecho con las manos",
   "keys": [
    "manos"
   ]
  },
  {
   "a": 54.2,
   "b": 56.6,
   "text": "supera a lo solo leído.",
   "keys": [
    "supera"
   ]
  },
  {
   "a": 58.7,
   "b": 60.75,
   "text": "Y los que repasamos.",
   "keys": [
    "repasamos"
   ]
  },
  {
   "a": 61.1,
   "b": 62.7,
   "text": "En un experimento,",
   "keys": [
    "experimento"
   ]
  },
  {
   "a": 62.7,
   "b": 64.9,
   "text": "quienes se pusieron a prueba",
   "keys": [
    "prueba"
   ]
  },
  {
   "a": 64.9,
   "b": 66.7,
   "text": "recordaron el 61%",
   "keys": [
    "recordaron"
   ]
  },
  {
   "a": 66.7,
   "b": 68.4,
   "text": "una semana después…",
   "keys": [
    "semana"
   ]
  },
  {
   "a": 68.4,
   "b": 71.1,
   "text": "quienes solo releyeron: 40%.",
   "keys": [
    "releyeron"
   ]
  },
  {
   "a": 72.2,
   "b": 74,
   "text": "Un viaje bien diseñado",
   "keys": [
    "diseñado"
   ]
  },
  {
   "a": 74,
   "b": 76.6,
