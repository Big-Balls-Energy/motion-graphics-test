 "scenes": [
  {
   "id": "hook",
   "name": "HOOK: EL ASTEROIDE Y LA TIERRA",
   "a": 0,
   "b": 6.5,
   "vis": "GLOBO_3D con continentes de puntos y atmósfera; un asteroide en llamas cruza el espacio. «¿SABÍAS QUE EL ASTEROIDE DE LOS DINOSAURIOS CAYÓ AQUÍ?». Pin pulsante en Yucatán y zoom desde el espacio hasta la península."
  },
  {
   "id": "impacto",
   "name": "IMPACTO EN CHICXULUB",
   "a": 6.5,
   "b": 19.8,
   "vis": "MAPA de la península (Natural Earth). Contador «66,000,000 AÑOS». El asteroide («≈10 KM») baja con estela de fuego y se estrella en la costa: destello blanco, onda expansiva, bola de fuego, escombros, sacudida y separación RGB. Anillos del cráter con «≈180 KM» y capas de roca caliza que lo entierran."
  },
  {
   "id": "anillo",
   "name": "EL ANILLO DE CENOTES",
   "a": 19.8,
   "b": 28.6,
   "vis": "HUD «VISTA SATELITAL · LANDSAT»: una línea de escaneo recorre el mapa en falso color y revela, punto por punto, el ANILLO DE CENOTES (≈165 KM) con Mérida dentro y Chichén Itzá fuera. Zoom infinito hacia un cenote que se convierte en la foto real."
  },
  {
   "id": "mayas",
   "name": "EL AGUA DE LOS MAYAS",
   "a": 28.6,
   "b": 40.6,
   "vis": "Y11_cenote_raices_colgantes.jpg con cáusticas de agua y rayos de luz: «CASI SIN RÍOS · EL AGUA ESTÁ BAJO TIERRA». Barrido a Y05 (Chichén Itzá): fichas que giran CHI · CHEN · ITZÁ → BOCA · POZO · DE LOS ITZÁES."
  },
  {
   "id": "materias",
   "name": "1 LUGAR · 5 MATERIAS",
   "a": 40.6,
   "b": 51.6,
   "vis": "«1 LUGAR» y «5 MATERIAS» caen con golpe. Cortes al ritmo de la voz, con contador 1/5…5/5: FÍSICA (impacto), GEOLOGÍA (corte de la roca caliza con cenote y agua subterránea), BIOLOGÍA (Y11), HISTORIA (Y01), GEOGRAFÍA (mapa del anillo). Mosaico final «1 VIAJE = 5 MATERIAS»."
  },
  {
   "id": "libro",
   "name": "NO CABE EN UN LIBRO",
   "a": 51.6,
   "b": 60.6,
   "vis": "Página gris de un libro de texto («Capítulo 7 · El fin del Cretácico») que se cierra de golpe. «Photo dump»: ocho fotos reales del viaje caen y se apilan con flash de cámara. Sobre ellas: «CABE EN UN VIAJE BIEN DISEÑADO.» (3 s sola)."
  },
  {
   "id": "cta",
   "name": "CIERRE",
   "a": 60.6,
   "b": 70,
   "vis": "Mapa con el anillo brillando de fondo. Avatar con logo, «VANGUARDIA ACADEMICS», «VIAJES EDUCATIVOS A LA MEDIDA», @vanguardia.academics y botón SEGUIR con clic. El último medio segundo regresa al globo del inicio (loop)."
  }
 ],
