 "scenes": [
  {
   "id": "hook",
   "name": "HOOK: «MA, ¿ME FIRMAS EL PERMISO?»",
   "a": 0,
   "b": 8,
   "vis": "Celular genérico con un chat: el hijo escribe «Ma, ¿me firmas el permiso?», manda el PDF del permiso y «Es para el viaje de la escuela». El celular sale y aparece el PERMISO en papel con cinco casillas vacías: «ANTES DE FIRMAR… 5 PREGUNTAS»."
  },
  {
   "id": "q1",
   "name": "1 · ¿QUÉ VA A APRENDER?",
   "a": 8,
   "b": 16,
   "vis": "Y05 (guía explicando en Chichén Itzá) en tarjeta. Tres fichas de vidrio con un ejemplo ilustrativo: OBJETIVO, VINCULADO A, ENTREGABLE. Barra de progreso 1/5."
  },
  {
   "id": "q2",
   "name": "2 · ¿QUIÉN LO ACOMPAÑA?",
   "a": 16,
   "b": 23.6,
   "vis": "E06 (equipo de guías) en tarjeta. Diagrama: un adulto conectado a un grupo de alumnos con «?»; luna y «¿QUIÉN RESPONDE DE NOCHE?»."
  },
  {
   "id": "q3",
   "name": "3 · ¿QUÉ CUBRE EL SEGURO?",
   "a": 23.6,
   "b": 31.3,
   "vis": "Y10 (tirolesa) de fondo. ESCUDO de vidrio que late y tres renglones de cobertura que se palomean: GASTOS MÉDICOS, HOSPITAL, REGRESO ANTICIPADO."
  },
  {
   "id": "q4",
   "name": "4 · ¿Y SI ALGO SALE MAL?",
   "a": 31.3,
   "b": 39.6,
   "vis": "S07 (Berlín) de fondo. Cadena animada INCIDENTE → COORDINADOR → FAMILIA con pulsos de luz, documento PROTOCOLO ESCRITO y teléfono que suena con «24/7»."
  },
  {
   "id": "q5",
   "name": "5 · LOS DOCUMENTOS",
   "a": 39.6,
   "b": 55.2,
   "vis": "Tres documentos genéricos en abanico (sin escudos oficiales): PASAPORTE, FORMATO SAM · INM, VISA O PERMISO. Ficha de ejemplo: Canadá (visa, o eTA con visa de EE. UU. vigente, en avión)."
  },
  {
   "id": "resumen",
   "name": "POR ESCRITO, ANTES DE SALIR",
   "a": 55.2,
   "b": 64.3,
   "vis": "Vuelve el PERMISO: las cinco casillas se palomean una tras otra, sello «POR ESCRITO · ANTES DE SALIR» y una firma que se escribe a mano. «CUANDO TODO ESTÁ CLARO, FIRMAR ES FÁCIL.» (3 s sola)."
  },
  {
   "id": "cta",
   "name": "CIERRE",
   "a": 64.3,
   "b": 75,
   "vis": "Íconos de GUARDAR y ENVIAR: «MÁNDALO AL GRUPO DE PAPÁS». Avatar con logo, «VANGUARDIA ACADEMICS», «VIAJES EDUCATIVOS A LA MEDIDA», @vanguardia.academics y botón SEGUIR con clic. El último medio segundo regresa al chat del inicio (loop)."
  }
 ],
