 "scenes": [
  {
   "id": "hook",
   "name": "HOOK: EL SALÓN QUE SE ABRE",
   "a": 0,
   "b": 6,
   "vis": "AULA_3D en penumbra: pizarrón con «Lección 14 · Repaso», pupitre y reloj. «¿POR QUÉ RECUERDAS… UN VIAJE». Las paredes del salón caen hacia afuera y aparece Y05_chichen_itza_guia_explicando.jpg con luz cálida; la cámara avanza hacia la pirámide. «…¿Y NO LA CLASE?» con «CLASE» tachada."
  },
  {
   "id": "kolb",
   "name": "APRENDIZAJE EXPERIENCIAL",
   "a": 6,
   "b": 18.4,
   "vis": "Fondo S14 desenfocado. Una polaroid de Y03_lancha_abrazo_amigas.jpg se revela con flash («lo vivido») y vuela a un nodo del CICLO_KOLB_3D: anillo de cristal con cuatro nodos que se encienden al decirlos (VIVIR → REFLEXIONAR → ENTENDER → APLICAR) mientras un cometa de luz recorre el anillo."
  },
  {
   "id": "arkansas",
   "name": "DATO 1 · ARKANSAS",
   "a": 18.4,
   "b": 30.8,
   "vis": "1,100 puntos (1 ≈ 10 estudiantes) aparecen y el contador llega a «CASI 11,000 ESTUDIANTES». Un SORTEO los divide en dos grupos (VISITAN EL MUSEO / GRUPO DE COMPARACIÓN); entra la tarjeta S14 «museo de arte». Después: «QUIENES FUERON MOSTRARON MÁS:» pensamiento crítico, empatía histórica, tolerancia."
  },
  {
   "id": "atlanta",
   "name": "DATO 2 · ATLANTA",
   "a": 30.8,
   "b": 43.3,
   "vis": "Fondo S12 (sala de conciertos) desenfocado. «3» enorme: SALIDAS CULTURALES AL AÑO. Tres BOLETOS_3D (MUSEO, TEATRO, ORQUESTA) entran en abanico. Paneles: FALTAS ↓ y EXÁMENES ↑; «Los efectos se mantuvieron al menos dos años»."
  },
  {
   "id": "global",
   "name": "DATO 3 · HABILIDADES GLOBALES",
   "a": 43.3,
   "b": 56,
   "vis": "GLOBO_3D de puntos con rutas de vuelo desde México hacia los destinos. «MÁS DE 4,500 UNIVERSITARIOS». «+70%» enorme. PASAPORTE con sellos que caen al decirlos: INTERCULTURAL, CURIOSIDAD, ADAPTABILIDAD, CONFIANZA."
  },
  {
   "id": "aula",
   "name": "CADA DESTINO ES UN AULA",
   "a": 56,
   "b": 73.5,
   "vis": "Itinerario ilustrativo dibujado en papel (DÍA 1–4). La cámara entra al pin del DÍA 2 y comienza el montaje de fotos reales con transiciones de barrido: HISTORIA (Y05, Chichén Itzá), SOSTENIBILIDAD (S07 Berlín, S04 Praga), EMPRENDIMIENTO (S05 Montreal) y destellos de HUMANIDADES, CIENCIAS y ARTE. Mosaico de 12 viajes que se aleja y la frase «CADA DESTINO ES UN AULA» con la palabra AULA rellena de foto (3 s sola)."
  },
  {
   "id": "social",
   "name": "ACCIÓN SOCIAL",
   "a": 73.5,
   "b": 82.3,
   "vis": "Gradación cálida, ritmo más lento: S19, S21 y S24 (obra comunitaria en Mérida) con una casa de línea que se dibuja; tarjeta «+10,000 personas apoyadas de forma directa · según Vanguardia Academics»; cierra con Y16_noche_barquitos_de_velas.jpg."
  },
  {
   "id": "cta",
   "name": "CIERRE",
   "a": 82.3,
   "b": 90,
   "vis": "Y08_catedral_atardecer_sin_personas.jpg. Dos puertas se abren con luz: «VIAJAR ABRE LAS PUERTAS / A NUEVOS APRENDIZAJES» (3 s sola). Logo en avatar, «VANGUARDIA ACADEMICS», «VIAJES EDUCATIVOS A LA MEDIDA», @vanguardia.academics y botón SEGUIR con cursor y clic. El último medio segundo regresa al salón del inicio (loop)."
  }
 ],
 "subs": [
  {
   "a": 0.15,
   "b": 2.75,
   "text": "¿Por qué recuerdas un viaje",
   "keys": [
    "viaje"
   ]
  },
  {
   "a": 2.95,
   "b": 5.35,
   "text": "…¿y no la clase pasada?",
   "keys": [
    "clase"
   ]
  },
  {
   "a": 6.25,
   "b": 8.45,
   "text": "Lo vivido en primera persona",
   "keys": [
    "vivido"
   ]
  },
  {
   "a": 8.45,
   "b": 10.15,
   "text": "se aprende distinto.",
   "keys": [
    "distinto"
   ]
  },
  {
   "a": 10.25,
   "b": 12,
   "text": "El investigador David Kolb",
   "keys": [
    "kolb"
   ]
  },
  {
   "a": 12,
   "b": 14.3,
   "text": "lo llamó aprendizaje experiencial:",
   "keys": [
    "experiencial"
   ]
  },
  {
   "a": 14.3,
   "b": 17.85,
   "text": "vivir, reflexionar, entender y aplicar.",
   "keys": [
    "vivir",
    "reflexionar",
    "entender",
    "aplicar"
   ]
  },
  {
   "a": 18.6,
   "b": 20.6,
   "text": "En Arkansas, casi 11,000",
   "keys": [
    "arkansas"
   ]
  },
  {
   "a": 20.6,
   "b": 22.35,
   "text": "estudiantes, en un sorteo",
   "keys": [
    "sorteo"
   ]
  },
  {
   "a": 22.35,
   "b": 24.15,
   "text": "para visitar un museo.",
   "keys": [
    "museo"
   ]
  },
  {
   "a": 24.55,
   "b": 26.15,
   "text": "Quienes fueron mostraron",
   "keys": [
    "fueron"
   ]
  },
  {
   "a": 26.15,
   "b": 27.9,
   "text": "más pensamiento crítico,",
   "keys": [
    "crítico"
   ]
  },
  {
   "a": 27.9,
   "b": 30.25,
   "text": "empatía histórica y tolerancia.",
   "keys": [
    "empatía",
    "tolerancia"
   ]
  },
  {
   "a": 31,
   "b": 32.9,
   "text": "En Atlanta, otro estudio",
   "keys": [
    "atlanta"
   ]
  },
  {
   "a": 32.9,
   "b": 34.85,
   "text": "sorteó salidas culturales:",
   "keys": [
    "salidas"
   ]
  },
  {
   "a": 34.85,
   "b": 37.25,
   "text": "museo, teatro y orquesta.",
   "keys": [
    "museo",
    "teatro",
    "orquesta"
   ]
  },
  {
   "a": 37.45,
   "b": 39.8,
   "text": "Faltaron menos a clases…",
   "keys": [
    "menos"
   ]
  },
  {
   "a": 39.8,
   "b": 42.75,
   "text": "y mejoraron en sus exámenes.",
   "keys": [
    "exámenes"
   ]
  },
  {
   "a": 43.55,
   "b": 45.6,
   "text": "Más de 4,500 universitarios",
   "keys": [
    "universitarios"
   ]
  },
  {
   "a": 45.6,
   "b": 47.95,
   "text": "que estudiaron en el extranjero…",
   "keys": [
    "extranjero"
   ]
  },
  {
   "a": 48.15,
   "b": 50.3,
   "text": "más del 70% notó",
   "keys": [
    "notó"
   ]
  },
  {
   "a": 50.3,
   "b": 52.1,
   "text": "mejores habilidades interculturales,",
   "keys": [
    "interculturales"
   ]
  },
  {
   "a": 52.1,
   "b": 55.5,
   "text": "curiosidad, adaptabilidad y confianza.",
   "keys": [
    "curiosidad",
    "adaptabilidad",
    "confianza"
   ]
  },
  {
   "a": 56.25,
   "b": 57.75,
   "text": "Por eso, cuando",
   "keys": [
    "eso"
   ]
  },
  {
   "a": 57.75,
   "b": 59.55,
   "text": "un viaje con intención…",
   "keys": [
    "intención"
   ]
  },
  {
   "a": 59.55,
   "b": 62.15,
   "text": "La historia, ante una pirámide.",
   "keys": [
    "historia"
   ]
  },
  {
   "a": 62.2,
   "b": 65.6,
   "text": "La sostenibilidad, en una empresa.",
   "keys": [
    "sostenibilidad"
   ]
  },
  {
   "a": 65.85,
   "b": 69.55,
   "text": "Emprender, en una ciudad bilingüe.",
   "keys": [
    "emprender"
   ]
  },
  {
   "a": 73.75,
   "b": 76,
   "text": "Lecciones que ningún libro enseña:",
   "keys": [
    "libro"
   ]
  },
  {
   "a": 76,
   "b": 78.2,
   "text": "construir junto a una comunidad",
   "keys": [
    "comunidad"
   ]
  },
  {
   "a": 78.2,
   "b": 80,
   "text": "algo que se queda.",
   "keys": [
    "queda"
   ]
  },
  {
   "a": 80,
   "b": 81.8,
   "text": "Eso también es educación.",
   "keys": [
    "educación"
   ]
  },
  {
   "a": 85.75,
   "b": 87.55,
   "text": "Compártelo con tu escuela",
   "keys": [
    "compártelo"
   ]
  },
  {
   "a": 87.55,
   "b": 89.45,
   "text": "y síguenos aquí.",
   "keys": [
    "síguenos"
   ]
  }
 ],
