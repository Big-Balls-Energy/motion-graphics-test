  },
  {
   "id": "usalo",
   "name": "ÚSALO EN TUS PRECIOS",
   "a": 36.2,
   "b": 42.7,
   "vis": "Tarjeta de precio: «$3,000 AL AÑO» se tacha y cambia a «MENOS DE $9 AL DÍA»; cuenta 3,000 ÷ 365 = 8.2."
  },
  {
   "id": "cta",
   "name": "CIERRE Y CTA CON PALABRA CLAVE",
   "a": 42.7,
   "b": 54,
